# Copy to .env (in this folder) and adjust. Never commit the real .env.

# --- Core -------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/tripsync
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
# Origin(s) of the React app, comma separated. Used for CORS and the Socket.IO origin check.
CLIENT_URL=http://localhost:5173
PORT=4000
NODE_ENV=development

# Set to true only when the client and API are on different sites (requires HTTPS).
CROSS_SITE_COOKIES=false
# Set to true behind a reverse proxy / load balancer so rate limits see the real client IP.
TRUST_PROXY=false

# --- External providers -----------------------------------------------------
# live = real providers (OSRM routing, Nominatim geocoding, Open-Meteo weather, Overpass places;
#        none of these need a key). demo = clearly-labelled mock data, no network calls.
PROVIDER_MODE=live
# Routing: tomtom is used automatically when TOMTOM_API_KEY is set, otherwise keyless OSRM.
# Uncomment to force one: osrm | tomtom | ors | demo
# ROUTING_PROVIDER=osrm
# TomTom Routing API key (https://developer.tomtom.com) — adds live traffic to ETAs, travel times
# and traffic-delay notifications. Free tier: 2,500 non-tile requests per day.
TOMTOM_API_KEY=
# Minimum minutes of traffic delay (and 15% of the no-traffic time) before notifying
TRAFFIC_DELAY_NOTIFY_MINUTES=5
GEOCODING_PROVIDER=nominatim     # nominatim | demo
WEATHER_PROVIDER=open-meteo      # open-meteo | demo
PLACES_PROVIDER=overpass         # overpass | demo
# Identify your deployment to the public OpenStreetMap services (their usage policies require it).
PROVIDER_USER_AGENT=TripSync/1.0 (self-hosted trip planner)

# OpenRouteService key — only used when ROUTING_PROVIDER=ors (no traffic data)
MAPS_API_KEY=
# Reserved for keyed weather adapters; Open-Meteo needs no key
WEATHER_API_KEY=
# Anthropic API key for optional AI itinerary generation. Empty = rule-based generator.
AI_API_KEY=
AI_MODEL=claude-opus-5-5

# Optional self-hosted endpoints
# OSRM_BASE_URL=https://routing.openstreetmap.de
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
EXTERNAL_TIMEOUT_MS=8000

# --- Tracking & privacy -----------------------------------------------------
# Days to keep location history (users can choose a shorter period and delete it any time)
LOCATION_RETENTION_DAYS=30
# Allow the clearly-labelled "simulate walk" demo positions (defaults to false in production)
ALLOW_DEMO_SIMULATION=true
ENABLE_JOBS=true

# --- Rate limits (per 15 min, location per minute) --------------------------
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_API_MAX=600
RATE_LIMIT_LOCATION_MAX=120
